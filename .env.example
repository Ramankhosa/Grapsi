# Server-only PatentNest Indian Patent Corpus API credential.
# Obtain a key in the pn_live_... format, then set it in the deployment environment.
PATENTNEST_API_KEY=

# Embedding safety controls for shared production servers.
# Keep query-time semantic search available, but stop background/stored vector creation.
STORED_EMBEDDING_JOBS_ENABLED=false

# Optional hard stop for every embedding provider call, including query-time search embeddings.
# Set to false only when you want all embedding generation disabled.
EMBEDDING_GENERATION_ENABLED=true

# Slow down this app's embedding provider calls so it does not compete with other apps.
EMBEDDING_MIN_INTERVAL_MS=1500
EMBEDDING_BATCH_CONCURRENCY=1
EMBEDDING_REQUEST_TIMEOUT_MS=20000
EMBEDDING_FAILURE_THRESHOLD=3
EMBEDDING_COOLDOWN_MS=120000
RUNTIME_SETTINGS_CACHE_MS=5000

# Public-project embedding worker low-impact defaults.
PUBLIC_PROJECT_EMBEDDING_WORKER_BATCH_SIZE=5
PUBLIC_PROJECT_EMBEDDING_WORKER_BATCH_COOLDOWN_MS=10000
PUBLIC_PROJECT_EMBEDDING_WORKER_INCLUDE_FAILED=false

# Funding document limits.
FUNDING_DOC_MAX_BYTES=10485760
FUNDING_DOC_CHUNK_TOKENS=512
FUNDING_DOC_CHUNK_OVERLAP=64
