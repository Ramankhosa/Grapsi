// Tenant-defined organizational hierarchy. Schools are roots (parent_id null)
// and Departments hang off them. Self-referential so deeper levels (Division,
// Centre) can be added later without another migration.
enum OrgUnitKind {
  SCHOOL
  DEPARTMENT
}

model TenantOrgUnit {
  id         String      @id @default(cuid())
  tenant_id  String
  parent_id  String?
  kind       OrgUnitKind
  name       String
  code       String?
  sort_order Int?
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent              TenantOrgUnit?      @relation("OrgUnitHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children            TenantOrgUnit[]     @relation("OrgUnitHierarchy")
  researcher_profiles ResearcherProfile[]

  // NOTE: Postgres treats NULLs as distinct, so this constraint only enforces
  // uniqueness for departments (non-null parent). School-name uniqueness is
  // enforced case-insensitively in the API layer.
  @@unique([tenant_id, parent_id, name], map: "tenant_org_units_tenant_parent_name_key")
  @@index([tenant_id, kind], map: "idx_tenant_org_units_tenant_kind")
  @@index([parent_id], map: "idx_tenant_org_units_parent")
  @@map("tenant_org_units")
}

enum CallAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CallAssignmentOutcome {
  PENDING
  AWARDED
  REJECTED
  WITHDRAWN
}

// A funding call handed to a faculty member by a tenant admin, with an
// internal deadline and message. The assignee closes it out by recording
// submission info.
model CallAssignment {
  id                  String               @id @default(cuid())
  tenant_id           String
  funding_call_id     String
  assignee_user_id    String
  assigned_by_user_id String
  message             String?
  deadline_at         DateTime?
  status              CallAssignmentStatus @default(ASSIGNED)

  // Snapshot of the match that motivated the assignment (provenance only).
  match_score Float?
  match_tier  String?
  match_basis String?

  // Submission proof recorded by the assignee on completion.
  submission_reference String?
  submission_url       String?
  submission_notes     String?
  submitted_at         DateTime?
  completed_at         DateTime?

  // Final funding decision, recorded by an admin after submission. Drives the
  // success-rate and funding-won reporting.
  outcome        CallAssignmentOutcome @default(PENDING)
  award_amount   Float?
  award_currency String?
  decision_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  funding_call  FundingCall    @relation(fields: [funding_call_id], references: [id], onDelete: Cascade)
  assignee      User           @relation("CallAssignmentAssignee", fields: [assignee_user_id], references: [id], onDelete: Cascade)
  assigned_by   User           @relation("CallAssignmentAssignedBy", fields: [assigned_by_user_id], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([funding_call_id, assignee_user_id], map: "call_assignments_call_assignee_key")
  @@index([tenant_id, assignee_user_id], map: "idx_call_assignments_tenant_assignee")
  @@index([tenant_id, status], map: "idx_call_assignments_tenant_status")
  @@index([tenant_id, outcome], map: "idx_call_assignments_tenant_outcome")
  @@index([assigned_by_user_id], map: "idx_call_assignments_assigned_by")
  @@index([deadline_at], map: "idx_call_assignments_deadline")
  @@map("call_assignments")
}

// In-app notification delivered to a single user. The app has no other inbox,
// so this is the primary channel for admin -> faculty messages and for
// automatic assignment events (email, where configured, is best-effort on top).
model Notification {
  id                 String    @id @default(cuid())
  tenant_id          String
  user_id            String
  title              String
  body               String?
  category           String    @default("ANNOUNCEMENT")
  link_url           String?
  assignment_id      String?
  created_by_user_id String?
  read_at            DateTime?
  created_at         DateTime  @default(now())

  tenant     Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user       User            @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  created_by User?           @relation("NotificationSender", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  assignment CallAssignment? @relation(fields: [assignment_id], references: [id], onDelete: SetNull)

  // Drives the unread badge.
  @@index([user_id, read_at], map: "idx_notifications_user_read")
  @@index([tenant_id, created_at], map: "idx_notifications_tenant_created")
  @@index([assignment_id], map: "idx_notifications_assignment")
  @@map("notifications")
}

