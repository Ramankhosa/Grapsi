enum TeamRole {
  LEAD // Team lead - can manage team settings
  MEMBER // Regular member
}

enum ATITokenStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ISSUED
  REVOKED
  EXPIRED
  USED_UP
}

// How the tenant behind an ATI token is governed.
// STANDARD: self-administered org (first user becomes OWNER, admins manage members)
// MANAGED:  administered from platform only — members never get OWNER/ADMIN
// EVENT:    MANAGED + time-boxed member access (workshops, demos, conferences)
enum ATITokenKind {
  STANDARD
  MANAGED
  EVENT
}

enum TenantInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  atiId     String       @unique
  type      TenantType   @default(ENTERPRISE) // Default to enterprise for existing tenants
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  projects  Project[]
  atiTokens ATIToken[]
  auditLogs AuditLog[]

  // Metering relations
  tenantPlans            TenantPlan[]
  usageReservations      UsageReservation[]
  usageMeters            UsageMeter[]
  usageLogs              UsageLog[]
  quotaAlerts            QuotaAlert[]
  patentDraftingUsage    PatentDraftingUsage[]
  serviceCompletionUsage ServiceCompletionUsage[]
  diagramGenerationUsage DiagramGenerationUsage[]
  sketchGenerationUsage  SketchGenerationUsage[]

  // Drafting relations
  draftingSessions DraftingSession[]

  // Idea Bank relations
  ideaBankIdeas IdeaBankIdea[]

  // Style Profile relations
  styleProfiles     StyleProfile[]
  styleTrainingJobs StyleTrainingJob[]
  documents         Document[]

  // Organizational structure
  teams           Team[]
  writingSamples  WritingSample[]
  writingPersonas WritingPersona[]

  // Paper Writing (academic papers)
  paperWritingSamples  PaperWritingSample[]
  paperWritingPersonas PaperWritingPersona[]

  // Style configuration overrides
  userDiagramStyles UserDiagramStyle[]
  userExportStyles  UserExportStyle[]

  // Ideation relations
  ideationSessions IdeationSession[]

  // Funding and grant relations
  fundingCalls                       FundingCall[]
  fundingImportJobs                  FundingImportJob[]
  grantSessions                      GrantSession[]
  grantPrepSessions                  GrantPrepSession[]
  grantBlueprints                    GrantBlueprint[]
  grantSectionDrafts                 GrantSectionDraft[]
  grantStructuredFieldResponses      GrantStructuredFieldResponse[]
  recommendationConversations        RecommendationConversation[]
  recommendationConversationMessages RecommendationConversationMessage[]
  recommendationConversationRuns     RecommendationConversationRun[]

  // Trial campaign relations
  trialCampaigns TrialCampaign[]

  // Tenant member invites
  memberInvites TenantMemberInvite[]

  // Organizational hierarchy, faculty imports and funding call assignments
  orgUnits          TenantOrgUnit[]
  callAssignments   CallAssignment[]
  facultyImportJobs FacultyImportJob[]
  notifications     Notification[]

  @@map("tenants")
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  LINKEDIN
  TWITTER
}

model User {
  id                       String     @id @default(cuid())
  tenantId                 String?
  signupAtiTokenId         String? // Track which ATI token was used for signup
  email                    String     @unique
  passwordHash             String?
  name                     String?
  firstName                String?
  lastName                 String?
  roles                    UserRole[] @default([ANALYST])
  status                   UserStatus @default(ACTIVE)
  emailVerified            Boolean    @default(false)
  accessExpiresAt          DateTime? // EVENT-kind signups: when this user's access ends (null = no expiry)
  noveltySearchesCompleted Int        @default(0) // Track successful novelty searches

  // Social login fields
  oauthProvider   OAuthProvider?
  oauthProviderId String?
  oauthProfile    Json? // Store additional OAuth profile data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signupAtiToken          ATIToken?               @relation("SignupATIToken", fields: [signupAtiTokenId], references: [id])
  projects                Project[]
  collaborations          ProjectCollaborator[]
  patents                 Patent[]
  annexureVersions        AnnexureVersion[]
  auditLogs               AuditLog[]
  usageLogs               UsageLog[]
  createdPriorArtBundles  PriorArtSearchBundle[]  @relation("PriorArtBundleCreator")
  approvedPriorArtBundles PriorArtSearchBundle[]  @relation("PriorArtBundleApprover")
  priorArtHistory         PriorArtSearchHistory[]
  priorArtRuns            PriorArtRun[]
  credits                 UserCredit?
  noveltyAssessments      NoveltyAssessmentRun[]
  noveltySearchRuns       NoveltySearchRun[]
  draftingSessions        DraftingSession[]
  draftingHistory         DraftingHistory[]

  // Reference Library (Mendeley-like personal library)
  referenceLibrary     ReferenceLibrary[]
  referenceCollections ReferenceCollection[]

  // Auth tokens
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  // Idea Bank relations
  createdIdeaBankIdeas IdeaBankIdea[]        @relation("IdeaBankIdeaCreator")
  ideaBankReservations IdeaBankReservation[]
  ideaBankHistory      IdeaBankHistory[]

  // Style Profile relations
  styleProfiles       StyleProfile[]     @relation("StyleProfileCreator")
  lockedStyleProfiles StyleProfile[]     @relation("StyleProfileLocker")
  ownedStyleProfiles  StyleProfile[]     @relation("StyleProfileUser")
  styleTrainingJobs   StyleTrainingJob[]
  documents           Document[]

  // Country Profile relations
  createdCountryProfiles CountryProfile[] @relation("CountryProfileCreator")
  updatedCountryProfiles CountryProfile[] @relation("CountryProfileUpdater")

  // Writing Samples for example-based style mimicry
  writingSamples  WritingSample[]
  createdPersonas WritingPersona[] @relation("PersonaCreator")

  // Paper Writing Samples for academic style mimicry
  paperWritingSamples  PaperWritingSample[]
  createdPaperPersonas PaperWritingPersona[] @relation("PaperPersonaCreator")

  // Team membership and service quotas
  teamMemberships TeamMember[]
  serviceQuotas   UserServiceQuota[]

  // Style configuration overrides
  userDiagramStyles       UserDiagramStyle[]
  userExportStyles        UserExportStyle[]
  userValidationOverrides UserValidationOverride[]

  // Config import tracking
  configImports CountryConfigImport[] @relation("ConfigImporter")

  // Service completion tracking
  serviceCompletionUsage ServiceCompletionUsage[]

  // Ideation relations
  ideationSessions IdeationSession[]

  // User-level section instructions (persistent across sessions)
  sectionInstructions UserSectionInstruction[]

  // Reference document attachments (PDFs)
  referenceDocuments ReferenceDocument[]

  // Library provider connections (Mendeley OAuth, Zotero API key)
  libraryConnections LibraryConnection[]

  // Funding finder and researcher profile relations
  grant_prep_sessions                GrantPrepSession[]
  recommendation_conversations       RecommendationConversation[]
  reviewer_calls                     ReviewerCall[]
  researcher_profile                 ResearcherProfile?
  researcher_notification_preference ResearcherNotificationPreference?
  researcher_saved_research_areas    ResearcherSavedResearchArea[]
  research_area_taxonomy_uploads     ResearchAreaTaxonomyUpload[]      @relation("ResearchAreaTaxonomyUploadImporter")
  platform_role_assignments          PlatformTeamRoleAssignment[]      @relation("PlatformRoleAssignmentUser")
  platform_role_assignments_assigned PlatformTeamRoleAssignment[]      @relation("PlatformRoleAssignmentAssigner")

  // Onboarding journey and tenant member invites
  journeyState      UserJourneyState?
  sentTenantInvites TenantMemberInvite[] @relation("TenantInviteSender")

  // Funding call assignments and faculty imports
  callAssignmentsReceived CallAssignment[]   @relation("CallAssignmentAssignee")
  callAssignmentsCreated  CallAssignment[]   @relation("CallAssignmentAssignedBy")
  facultyImportJobs       FacultyImportJob[]
  notifications           Notification[]     @relation("NotificationRecipient")
  sentNotifications       Notification[]     @relation("NotificationSender")

  @@map("users")
}

model PlatformTeamRoleAssignment {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  roleCode         String   @map("role_code")
  assignedByUserId String?  @map("assigned_by_user_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user       User  @relation("PlatformRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("PlatformRoleAssignmentAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleCode], map: "platform_team_role_assignments_user_role_key")
  @@index([userId, isActive], map: "idx_platform_team_role_assignments_user_active")
  @@index([roleCode, isActive], map: "idx_platform_team_role_assignments_role_active")
  @@index([assignedByUserId], map: "idx_platform_team_role_assignments_assigned_by")
  @@map("platform_team_role_assignments")
}

// Email verification tokens for new users
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Refresh tokens for JWT rotation (stored for revocation capability)
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique // SHA256 hash of the token
  familyId      String // Token family for rotation detection
  expiresAt     DateTime
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String? // "logout", "rotation", "security", "admin"
  userAgent     String? // Browser/device info for session management
  ipAddress     String? // IP address at token creation
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ATIToken {
  id             String         @id @default(cuid())
  tenantId       String?
  tokenHash      String
  rawToken       String? // Encrypted raw token for revelation (temporary)
  rawTokenExpiry DateTime? // When raw token can no longer be revealed
  fingerprint    String
  status         ATITokenStatus @default(ISSUED)
  expiresAt      DateTime?
  maxUses        Int?
  usageCount     Int            @default(0)
  planTier       String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Explicit role and team assignment for new users
  assignedRole   UserRole? // Explicit role for users who sign up with this token
  assignedTeamId String? // Team to auto-add user to on signup

  // Governance kind and time-boxed access (EVENT kind)
  kind              ATITokenKind @default(STANDARD)
  memberAccessHours Int? // EVENT: each member's access duration from their signup
  accessEndsAt      DateTime? // EVENT: hard cutoff for all members (event end)
  eventLabel        String? // e.g. "AI Grants Workshop – July 15"

  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signupUsers  User[]              @relation("SignupATIToken")
  assignedTeam Team?               @relation("ATITokenTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  memberInvite TenantMemberInvite?

  @@map("ati_tokens")
}

// Named, email-locked invitation to join a tenant. Backed by a single-use ATI
// token — the invite adds identity (who was invited, by whom, as what role)
// on top of the ATI redemption mechanism.
model TenantMemberInvite {
  id              String             @id @default(cuid())
  tenantId        String
  email           String
  role            UserRole           @default(ANALYST)
  teamId          String?
  atiTokenId      String             @unique
  status          TenantInviteStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  atiToken  ATIToken @relation(fields: [atiTokenId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("TenantInviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([email])
  @@map("tenant_member_invites")
}

// Per-user onboarding journey state. Milestones are primarily computed from
// real data at read time; this table stores event-only milestones (first
// match viewed, tours dismissed) and the dismissal of the checklist itself.
model UserJourneyState {
  id             String   @id @default(cuid())
  userId         String   @unique
  milestones     Json     @default("{}")
  dismissedTours String[] @default([])
  checklistDone  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_journey_states")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  resource    String
  ip          String?
  meta        Json?
  createdAt   DateTime @default(now())

  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE: Teams and Access Control
// ============================================================================

// Team within a tenant organization
model Team {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false) // Default team for new users (if set)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // User ID who created the team

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  serviceAccess   TeamServiceAccess[]
  invitedByTokens ATIToken[]          @relation("ATITokenTeam")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

// Team membership
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// Team-level service access control
model TeamServiceAccess {
  id          String      @id @default(cuid())
  teamId      String
  serviceType ServiceType
  isEnabled   Boolean     @default(true)

  // Optional quotas at team level (overrides tenant plan if set)
  monthlyQuota Int? // NULL = use tenant plan quota
  dailyQuota   Int? // NULL = use tenant plan quota

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, serviceType])
  @@map("team_service_access")
}

// User-level service quota overrides (most granular level)
model UserServiceQuota {
  id          String      @id @default(cuid())
  userId      String
  serviceType ServiceType
  isEnabled   Boolean     @default(true)

  // Optional quotas at user level (overrides team quota if set)
  monthlyQuota Int? // NULL = use team/tenant quota
  dailyQuota   Int? // NULL = use team/tenant quota

  // Usage tracking
  currentMonthUsage Int      @default(0)
  currentDayUsage   Int      @default(0)
  lastResetDate     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceType])
  @@map("user_service_quotas")
}

model Project {
  id                            String                         @id @default(cuid())
  name                          String
  projectType                   ProjectType                    @default(PATENT)
  userId                        String
  tenantId                      String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  applicantProfile              ApplicantProfile?
  collaborators                 ProjectCollaborator[]
  patents                       Patent[]
  grantSessions                 GrantSession[]
  grantPrepSessions             GrantPrepSession[]
  grantBlueprints               GrantBlueprint[]
  grantSectionDrafts            GrantSectionDraft[]
  grantStructuredFieldResponses GrantStructuredFieldResponse[]
  noveltySearchRuns             NoveltySearchRun[]
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("projects")
}

model ApplicantProfile {
  id                         String            @id @default(cuid())
  projectId                  String            @unique
  applicantLegalName         String
  applicantCategory          ApplicantCategory
  applicantAddressLine1      String
  applicantAddressLine2      String?
  applicantCity              String
  applicantState             String
  applicantCountryCode       String
  applicantPostalCode        String
  correspondenceName         String
  correspondenceEmail        String
  correspondencePhone        String
  correspondenceAddressLine1 String
  correspondenceAddressLine2 String?
  correspondenceCity         String
  correspondenceState        String
  correspondenceCountryCode  String
  correspondencePostalCode   String
  useAgent                   Boolean           @default(false)
  agentName                  String?
  agentRegistrationNo        String?
  agentEmail                 String?
  agentPhone                 String?
  agentAddressLine1          String?
  agentAddressLine2          String?
  agentCity                  String?
  agentState                 String?
  agentCountryCode           String?
  agentPostalCode            String?
  defaultJurisdiction        Jurisdiction
  defaultRoute               FilingRoute
  defaultLanguage            String            @default("EN")
  defaultEntityStatusIn      EntityStatus
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("applicant_profiles")
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("collaborator") // owner, collaborator, viewer
  addedBy   String // userId of who added this collaborator
